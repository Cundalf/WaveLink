<?xml version="1.0" encoding="utf-8"?>
<!-- El password de estación vive solo en DataStore local: se excluye de
     backups en la nube y de transferencias dispositivo-a-dispositivo. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>