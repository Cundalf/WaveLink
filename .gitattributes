# Normalización de finales de línea (repos cross-platform)
* text=auto eol=lf

# Scripts de Windows
*.bat text eol=crlf
*.cmd text eol=crlf

# Binarios
*.jar binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.apk binary
*.aab binary
*.jks binary
*.keystore binary

# Estadísticas de lenguaje
*.kt linguist-language=Kotlin
*.kts linguist-language=Kotlin
